# Node modules
node_modules/

# package-lock.json is COMMITTED on purpose. It was ignored, which meant there
# was no reproducible install anywhere: `npm ci` could not run, and every clone
# and every CI job re-resolved the tree from scratch, so a transitive patch
# release could change what shipped between two builds of the same commit. A
# library can reasonably omit a lockfile. An application cannot.

# Next.js build output
.next/
# Isolated build directories. Running `next build` into `.next` while a dev
# server is serving from it takes the dev server down, so verification builds
# get their own DIST_DIR — and those were landing in `git status`, one keystroke
# away from being swept into a commit by `git add -A`.
.next-*/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Claude Code — machine-local permission grants
.claude/settings.local.json

# Optional: if using TurboRepo or monorepo
turbo/
# Local env (never commit real credentials)
.env.local
.env*.local

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
