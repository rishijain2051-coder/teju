# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials.

# ─── Site ────────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://vardhman-impex.com"

# ─── Enquiry email (SMTP) ────────────────────────────────────────────────────
# Both enquiry forms POST to /api/enquiry, which sends through these. Leave them
# blank and the route returns a clear error instead of silently dropping a lead —
# visitors are pointed at the WhatsApp button and the address below.
#
# Gmail: turn on 2-Step Verification, then create a 16-character App Password
# (Google Account → Security → App passwords) and use that as SMTP_PASS. Your
# normal account password will not work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
# The From header. Some providers require this to match SMTP_USER's address.
MAIL_FROM="Vardhman Impex <youraddress@gmail.com>"

# ─── Private catalogue access ────────────────────────────────────────────────
# Comma-separated codes that unlock /collections/private/catalogue.
# Checked server-side only; never sent to the browser.
ACCESS_CODES=""

# Signs the access cookie. Without this the gate denies everyone, which is the
# safe direction — the cookie used to hold the literal word "granted" and could
# be forged from the devtools cookie editor.
#
# Generate one (minimum 32 characters):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Use a DIFFERENT value in production from the one in your local .env.local, and
# rotate it to sign every issued cookie out at once.
ACCESS_SECRET=""
