# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# credentials.

# ─── Site ────────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://vardhman-impex.com"

# ─── Enquiry email (SMTP) ────────────────────────────────────────────────────
# Both enquiry forms POST to /api/enquiry, which sends through these. Leave them
# blank and the route returns a clear error instead of silently dropping a lead —
# visitors are pointed at the WhatsApp button and the address below.
#
# Gmail: turn on 2-Step Verification, then create a 16-character App Password
# (Google Account → Security → App passwords) and use that as SMTP_PASS. Your
# normal account password will not work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
# The From header. Some providers require this to match SMTP_USER's address.
MAIL_FROM="Vardhman Impex <youraddress@gmail.com>"

# ─── Private catalogue access ────────────────────────────────────────────────
# BOTH of these are required. Either one missing or malformed and the gate turns
# every correct code away.
#
# !! NO QUOTES IN A HOSTING DASHBOARD !!
# dotenv strips quotes from this file. The Vercel and Netlify dashboards do NOT —
# they store whatever you paste, character for character. Paste
# ACCESS_CODES="alpha,bravo" into Vercel and the codes become `"alpha` and
# `bravo"`, so every real code is refused and it looks exactly like a wrong code.
# Type the value alone, with no quotes and no trailing spaces.

# Comma-separated codes that unlock /collections/private/catalogue. Checked
# server-side only; never sent to the browser. Lower-cased and trimmed before
# comparison, so `Alpha` and ` alpha ` both match `alpha`. Avoid commas (the
# separator) and quotes (stripped) inside a code.
#
# Format, unquoted:  ACCESS_CODES=firstcode,secondcode,thirdcode
# Left blank on purpose — a committed default here would be a working credential.
ACCESS_CODES=""

# Signs the access cookie. Without this the gate denies everyone, which is the
# safe direction — the cookie used to hold the literal word "granted" and could
# be forged from the devtools cookie editor.
#
# MINIMUM 32 CHARACTERS, enforced. Anything shorter is treated as unset: the gate
# denies everyone and /api/verify-access answers 503, not a wrong-code 401. A
# hand-picked passphrase will almost certainly be too short — generate one:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The same value must be present wherever middleware runs and wherever
# /api/verify-access runs. On Vercel that means ticking the environment (usually
# Production) once — both read the same variable — and redeploying.
#
# Use a DIFFERENT value in production from the one in your local .env.local, and
# rotate it to sign every issued cookie out at once.
ACCESS_SECRET=""

# ─── Analytics (GA4) ─────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, in the form G-XXXXXXXXXX (Admin → Data
# streams → your web stream). Leave it unset and no analytics is rendered at
# all — no script tag, no requests, nothing to consent to.
#
# NEXT_PUBLIC_ means this is inlined into the client bundle at BUILD time, not
# read at runtime like the variables above. Changing it in your host's dashboard
# does nothing until you redeploy.
NEXT_PUBLIC_GA_ID=""
